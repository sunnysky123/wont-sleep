<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="wont_sleep.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:wont_sleep"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock x:Uid="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="PageSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,20">
                <StackPanel Spacing="16">

                    <ToggleSwitch
                        x:Name="PreventSleepToggle"
                        x:Uid="PreventSleepToggle"
                        IsOn="False"
                        Toggled="PreventSleepToggle_Toggled" />

                    <CheckBox
                        x:Name="KeepDisplayCheckBox"
                        x:Uid="KeepDisplayCheckBox"
                        IsChecked="False"
                        Checked="KeepDisplayCheckBox_Changed"
                        Unchecked="KeepDisplayCheckBox_Changed" />

                    <StackPanel Spacing="8">
                        <ComboBox
                            x:Name="DurationComboBox"
                            x:Uid="DurationComboBox"
                            MinWidth="220"
                            SelectedIndex="0"
                            SelectionChanged="DurationComboBox_SelectionChanged">
                            <!-- 选项由 DurationOptions.Labels 在代码中填充，与托盘菜单保持一致。 -->
                        </ComboBox>
                        <ProgressBar
                            x:Name="RemainingProgressBar"
                            Height="4"
                            Maximum="1"
                            Minimum="0"
                            Value="1"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Name="ModeComboBox"
                            x:Uid="ModeComboBox"
                            MinWidth="320"
                            SelectedIndex="0"
                            SelectionChanged="ModeComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="ModePowerRequestItem" />
                            <ComboBoxItem x:Uid="ModeThreadStateItem" />
                        </ComboBox>
                        <TextBlock
                            x:Name="ModeDescriptionText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StatusText"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="ElapsedText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="MessageBar"
                IsClosable="True"
                IsOpen="False" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16,20,20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AppearanceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox
                        x:Name="ThemeComboBox"
                        MinWidth="220"
                        SelectedIndex="0"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="ThemeSystemItem" />
                        <ComboBoxItem x:Uid="ThemeLightItem" />
                        <ComboBoxItem x:Uid="ThemeDarkItem" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock
                x:Uid="FooterNote"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
