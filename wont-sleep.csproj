<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>wont_sleep</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      不要把语言资源拆成独立的 .msix 资源包：
      默认值为 Language|Scale|DXFeatureLevel，会把 zh-CN 拆出去，
      而我们提交的 bundle 只包含主包，中文系统就会因缺少资源包而回退到英文界面。
    -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIconIdle.ico" />
    <!-- Assets\source 只存放图标生成脚本与母版图片，不参与 MSIX 打包 -->
    <Content Remove="Assets\source\**" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <!--
    只引用实际用到的 Windows App SDK 组件，而不是聚合包 Microsoft.WindowsAppSDK。
    聚合包会连带引入 AI / ML / Search / Widgets，其中 ML 会把 onnxruntime.dll（约 22 MB）
    和 DirectML.dll（约 18 MB）复制进安装包，而本应用完全不使用这些能力。
    组件清单与聚合包 2.6.5 保持一致，仅去掉 AI / ML / Search / Widgets。
    升级 SDK 版本时这些版本号需要一起改。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>

    <!--
      Native AOT 默认关闭，按需开启：
        dotnet publish -c Release -p:PublishAot=true
      开启后需要 MSVC 链接器与 Windows SDK（Visual Studio「使用 C++ 的桌面开发」工作负载）。
      默认关闭可保证在未安装 C++ 工具链的机器上也能正常生成 MSIX / EXE。
    -->
    <PublishReadyToRun Condition="'$(PublishAot)' == 'true'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">False</PublishReadyToRun>
  </PropertyGroup>

  <!--
    .NET 运行时包会把这些「只为调试器 / dotnet-dump 服务」的原生文件一起复制到输出目录
    （运行时清单里标记为 DropFromSingleFile="true"），应用正常运行完全不需要：
      mscordaccore*.dll / mscordbi.dll  调试与转储所需的 DAC / DBI
      createdump.exe                    生成转储的辅助工具
      Microsoft.DiaSymReader.Native.*   读取 PDB 符号
    合计约 6 MB，这里从复制项里剔除，避免进入 MSIX。
  -->
  <Target Name="_RemoveRuntimeDiagnosticsFiles"
          Condition="'$(Configuration)' != 'Debug'"
          BeforeTargets="_CopyFilesMarkedCopyLocal;ComputeFilesToPublish">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(mscordaccore|mscordbi|createdump|Microsoft\.DiaSymReader\.Native)'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(mscordaccore|mscordbi|createdump|Microsoft\.DiaSymReader\.Native)'))" />
      <RuntimePackAsset Remove="@(RuntimePackAsset)"
                        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(mscordaccore|mscordbi|createdump|Microsoft\.DiaSymReader\.Native)'))" />
    </ItemGroup>
  </Target>
</Project>